# API service configuration
VAPOR_ENV=production
LOG_LEVEL=info
API_BIND="127.0.0.1:8080"
API_APIKEYS_PATH=
API_SYNC_APIKEYS=

# Email address to send failure notifications to
# NOTIFICATION_EMAIL=

# Sync client configuration
SYNC_ENABLED=false
SYNC_APIKEY=
SYNC_SERVER=
SYNC_DOMAINS=
SYNC_VARIABLES=
SYNC_PAST_DAYS=7
SYNC_CONCURRENT=4
SYNC_REPEAT_INTERVAL=10

# Fetch data from a remote S3 bucket and cache it locally.
# REMOTE_DATA_DIRECTORY=https://openmeteo.s3.amazonaws.com/data/
# CACHE_SIZE=8GB
# Maximum simultaneous block-cache range downloads per API process across all upstreams.
# Includes foreground misses, prefetch and preloading; duplicates share one download.
# Extra downloads wait FIFO. Retries retain their slot; health checks/listings are separate.
# Tune for the number of API processes and possible uneven load between endpoints.
# UPSTREAM_FETCH_CONCURRENCY=60
